PORT=3000
HOST=0.0.0.0
NODE_ENV=development

MONGODB_URI=mongodb://127.0.0.1:27017/financial-budgeting

JWT_SECRET=replace-with-a-secure-jwt-secret-of-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-secure-refresh-secret-of-at-least-32-characters
JWT_REFRESH_EXPIRES_IN=7d
ADMIN_SECRET_KEY=replace-with-a-secure-admin-secret-of-at-least-32-characters
MONO_WEBHOOK_SECRET=replace-with-a-secure-webhook-secret-of-at-least-32-characters

BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=SEFA
BREVO_REPLY_TO_EMAIL=

CORS_ORIGIN=http://localhost:8081,http://localhost:3000,http://127.0.0.1:8081,http://127.0.0.1:3000
