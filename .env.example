# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/financial-budgeting

# Email (Brevo)
BREVO_API_KEY=
BREVO_SENDER_NAME=SEFA
BREVO_SENDER_EMAIL=
BREVO_API_URL=https://api.brevo.com

# JWT Configuration
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:8081,http://localhost:3000,http://127.0.0.1:8081,http://127.0.0.1:3000

# API Documentation
SWAGGER_ENABLED=true

# Admin Configuration
ADMIN_SECRET_KEY=

# Bank Integration (Mono)
MONO_SECRET_KEY=
MONO_PUBLIC_KEY=
MONO_WEBHOOK_SECRET=
MONO_ENVIRONMENT=test
MONO_REDIRECT_URL=http://localhost:3000/api/bank/callback

# File Storage (MongoDB GridFS)
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=text/csv,application/pdf

# Document Processing (Azure AI Document Intelligence)
AZURE_DOCUMENT_ENDPOINT=
AZURE_DOCUMENT_API_KEY=

# OCR (Google Cloud Vision)
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT_ID=

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Encryption
ENCRYPTION_KEY=
ENCRYPTION_ALGORITHM=aes-256-cbc

# Push Notifications (Expo)
EXPO_ACCESS_TOKEN=
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# Background Jobs
SYNC_FREQUENCY_MS=43200000
NOTIFICATION_DIGEST_TIME=09:00
NOTIFICATION_WEEKLY_DAY=0
NOTIFICATION_WEEKLY_TIME=20:00
NOTIFICATION_RETENTION_DAYS=90
IMPORT_RETENTION_DAYS=90

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_MODEL_NAME=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_MAX_TOKENS=3000

# Assistant Live Web Retrieval
TAVILY_API_KEY=
SERPAPI_API_KEY=
